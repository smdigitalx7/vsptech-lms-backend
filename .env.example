# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=FastAPI Docker Template
APP_DESCRIPTION=Production-ready FastAPI boilerplate template
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=local

# ============================================================================
# Security Settings
# ============================================================================
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Argon2id Password Hashing Settings
# ============================================================================
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# ============================================================================
# Database Settings
# ============================================================================
# Option 1: Use DATABASE_URL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# Option 2: Use individual PostgreSQL settings (fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fastapi_db

# ============================================================================
# Database Connection Pool Settings
# ============================================================================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# Redis Settings
# ============================================================================
# Option 1: Use REDIS_URL (recommended for production)
# REDIS_URL=redis://localhost:6379

# Option 2: Use individual Redis settings (fallback)
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6379
REDIS_RATE_LIMIT_HOST=localhost
REDIS_RATE_LIMIT_PORT=6379

# ============================================================================
# Cache Settings
# ============================================================================
CLIENT_CACHE_MAX_AGE=3600

# ============================================================================
# Rate Limiting Settings
# ============================================================================
DEFAULT_RATE_LIMIT_LIMIT=100
DEFAULT_RATE_LIMIT_PERIOD=60

# ============================================================================
# API Configuration
# ============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
DEFAULT_PAGE=1

# ============================================================================
# Thread Pool Configuration
# ============================================================================
THREAD_POOL_TOKENS=100

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_RETENTION_DAYS=30

# ============================================================================
# CORS Settings
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600
CORS_ALLOW_HEADERS=Authorization,Content-Type
CORS_EXPOSE_HEADERS=X-Total-Count,X-Page-Count
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
# ============================================================================
# Gunicorn Configuration
# ============================================================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEP_ALIVE=5
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=25
