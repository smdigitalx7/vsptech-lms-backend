# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=FastAPI Application
APP_DESCRIPTION=FastAPI Application Description
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=local

# ============================================================================
# Security Settings
# ============================================================================
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id Password Hashing Settings
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# ============================================================================
# Security Headers Settings (NEW)
# ============================================================================
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
REFERRER_POLICY=strict-origin-when-cross-origin

# ============================================================================
# File Upload Settings (NEW)
# ============================================================================
# Maximum file upload size in bytes (default: 10485760 = 10MB)
MAX_FILE_SIZE=10485760
# Comma-separated list of allowed file types
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png

# ============================================================================
# Core Threshold (NEW)
# ============================================================================
CORE_THRESHOLD=10000000

# ============================================================================
# Database Settings
# ============================================================================
# Use DATABASE_URL for full connection string, or use individual PostgreSQL settings
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fastapi_db

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# Redis Settings
# ============================================================================
# Use REDIS_URL for full connection string, or use individual Redis settings
# REDIS_URL=redis://localhost:6379
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6379
REDIS_RATE_LIMIT_HOST=localhost
REDIS_RATE_LIMIT_PORT=6379

# ============================================================================
# Cache Settings
# ============================================================================
CLIENT_CACHE_MAX_AGE=3600

# ============================================================================
# Rate Limiting
# ============================================================================
DEFAULT_RATE_LIMIT_LIMIT=100
DEFAULT_RATE_LIMIT_PERIOD=60

# ============================================================================
# CORS Settings (UPDATED)
# ============================================================================
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600
# Comma-separated list of allowed CORS headers
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin
# Comma-separated list of exposed CORS headers
CORS_EXPOSE_HEADERS=Content-Length,Content-Range
# Comma-separated list of allowed CORS methods
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH

# ============================================================================
# Authentication Paths (UPDATED)
# ============================================================================
# Paths that skip authentication (can be JSON array string or comma-separated)
# Example JSON: ["/health","/docs","/redoc","/openapi.json","/api/v1/public/auth/login"]
# Example comma-separated: /health,/docs,/redoc,/openapi.json,/api/v1/public/auth/login
SKIP_AUTH_PATHS=["/health","/docs","/redoc","/openapi.json","/api/v1/public/auth/login","/api/v1/public/auth/refresh","/api/v1/public/auth/register","/api/v1/public/auth/forgot-password","/api/v1/public/auth/reset-password","/api/v1/public/auth/verify-otp","/api/v1/public/auth/resend-otp"]
# Paths that require refresh token (can be JSON array string or comma-separated)
REFRESH_PATHS=["/api/v1/public/auth/refresh"]

# ============================================================================
# API Configuration
# ============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
DEFAULT_PAGE=1

# ============================================================================
# Thread Pool Configuration
# ============================================================================
THREAD_POOL_TOKENS=100

# ============================================================================
# Gunicorn Configuration
# ============================================================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEP_ALIVE=5
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=25

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_RETENTION_DAYS=30
